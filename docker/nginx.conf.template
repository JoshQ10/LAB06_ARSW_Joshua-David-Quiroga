server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # El backend del Lab 4 no expone CORS: el navegador ve front y API en el mismo origen.
  location /api/ {
    proxy_pass ${BACKEND_URL};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location /auth/ {
    proxy_pass ${BACKEND_URL};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  # Rutas de React Router (SPA)
  location / {
    try_files $uri $uri/ /index.html;
  }
}
