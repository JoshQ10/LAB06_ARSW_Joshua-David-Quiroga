# true  -> usa apimock (datos en memoria, no requiere backend)
# false -> usa apiclient (API REST real del Lab 4 con JWT)
VITE_USE_MOCK=true

# URL base de la API de blueprints. Con la ruta relativa las peticiones pasan
# por el proxy de Vite (evita CORS). También acepta una URL absoluta.
VITE_API_BASE_URL=/api/v1

# Endpoint de login que emite el JWT ({ access_token }).
VITE_AUTH_URL=/auth/login

# Destino del proxy de Vite (dónde corre el backend del Lab 4).
VITE_BACKEND_URL=http://localhost:8080
